{
  "name": "@qualcomm-ui/oxlint-config",
  "version": "1.0.0",
  "description": "QUI Oxlint config for consistent TypeScript and React linting",
  "author": "Ryan Bower",
  "license": "BSD-3-Clause-Clear",
  "repository": "https://github.com/qualcomm/qualcomm-ui",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "config",
    "lint",
    "oxlint"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    "./base": {
      "types": "./dist/base.d.ts",
      "import": "./dist/base.js"
    },
    "./angular": {
      "types": "./dist/angular.d.ts",
      "import": "./dist/angular.js"
    },
    "./typescript": {
      "types": "./dist/typescript.d.ts",
      "import": "./dist/typescript.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "scripts": {
    "clean": "shx rm -rf dist",
    "compile": "tsc -b tsconfig.lib.json --force",
    "build": "run-s clean compile",
    "test": "pnpm build && vitest -c vitest.config.ts --run",
    "test:unit:ci": "pnpm build && cross-env NODE_OPTIONS='' vitest -c vitest.config.ts --run --pool=threads --no-file-parallelism",
    "test:watch": "vitest -c vitest.config.ts",
    "prepublishOnly": "qui-cli pre-publish",
    "postpublish": "qui-cli post-publish"
  },
  "devDependencies": {
    "@qualcomm-ui/cli": "catalog:",
    "@qualcomm-ui/tsconfig": "catalog:",
    "cross-env": "^10.1.0",
    "npm-run-all2": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "0.22.1",
    "shx": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "oxlint": ">=1.68.0"
  }
}
