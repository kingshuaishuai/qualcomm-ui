{
  "extends": "@qualcomm-ui/tsconfig/tsconfig.strict.json",
  "compilerOptions": {
    "composite": true,
    "rootDir": "./src",
    "module": "NodeNext",
    "outDir": "./dist",
    "emitDeclarationOnly": false,
    "moduleResolution": "NodeNext",
    "tsBuildInfoFile": "node_modules/.tmp/.tsbuildinfo"
  },
  "include": ["./src"]
}
